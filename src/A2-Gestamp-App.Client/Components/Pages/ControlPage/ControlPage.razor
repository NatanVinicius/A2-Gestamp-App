@page "/control"
@using A2GestampApp.Client.Components.Pages.HomePage.Components

<div class="flex h-full w-full flex-col gap-4 pr-2">
	<h3 class="text-white/60">
		> Controle
	</h3>

	<div class="flex items-center justify-between rounded-md px-4">
		<div>
			<p>Olá, @(UserState.User?.Name)</p>
		</div>
		@if (UserState.User?.Name == null)
		{
			<div class="flex items-center justify-center gap-6">

				<div class="flex items-center justify-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star @(CanChangeJudgment
																																		 ? "fa-solid fa-star text-xl text-yellow-500"
																																		 : "fa-solid fa-star text-xl text-white")">
						<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
					</svg>

					<p class="text-xs font-semibold">
						@(CanChangeJudgment ? "Administrador" : "Operador")
					</p>
				</div>
				<button @onclick="ChangeUserLogged" class="cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat2-icon lucide-repeat-2"><path d="m2 9 3-3 3 3" /><path d="M13 18H7a2 2 0 0 1-2-2V6" /><path d="m22 15-3 3-3-3" /><path d="M11 6h6a2 2 0 0 1 2 2v10" /></svg>
				</button>

			</div>
		}
	</div>

	<div class="flex min-h-0 flex-1 gap-4 overflow-hidden">
		<Inspection CameraCount="3"
					CurrentIndex="@_currentIndex"
					CurrentIndexChanged="@(i => _currentIndex = i)"
					Camera="@CurrentCamera"
					ImageVersion="@_imageVersion"
					RenderMode="InspectionRenderMode.ImageWithOverlay" />

		<Tools Camera="@CurrentCamera" />
	</div>

	<div class="flex justify-end gap-4">

		<button @onclick="ChangeJudgmentAsync"
				disabled="@(!CanChangeJudgment)"
				class="cursor-pointer rounded-lg bg-red-500 px-8 py-2 font-semibold
			transition hover:bg-red-500/80
			disabled:cursor-not-allowed disabled:opacity-20">

			Alterar Julgamento

		</button>

		<button @onclick="SaveAsync"
				disabled="@(!CanSave)"
				class="cursor-pointer rounded-lg bg-green-500 px-8 py-2 font-semibold
			transition hover:bg-green-500/80
			disabled:cursor-not-allowed disabled:opacity-20">

			Salvar

		</button>

	</div>
</div>


