@using Microsoft.AspNetCore.Components

<div class="h-full w-full min-h-0 flex flex-col bg-card rounded-md overflow-hidden">
  <div class="flex justify-between py-4 px-4 text-sm bg-border">
    <p>INSPEÇÃO ATUAL</p>
    <div class="flex gap-6">
      <p>imagem_01232.jpg</p>
      <div>
        <i class="fa-solid fa-camera text-primary"></i>
        <span>1</span>
      </div>
    </div>
  </div>
    <div class="relative flex-1 flex overflow-hidden px-4 pt-4">
        <div class="w-full h-full flex items-center justify-center rounded-md shadow-lg overflow-hidden ">
            <img src="@CurrentImage"
                 alt="Inspection Image"
                 class="w-full h-full object-fill select-none transition-all duration-500" />
        </div>

        @if (ImageCount > 1)
        {
            <button @onclick="Previous"
                    class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition">

                ❮

            </button>

            <button @onclick="Next"
                    class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition">

                ❯

            </button>
        }

    </div>

    @if (ImageCount > 1)
    {
        <div class="flex justify-center gap-4 pt-2 pb-4">

            @for (int i = 0; i < ImageCount; i++)
            {
                int index = i;

                <button @onclick="() => GoTo(index)"
                        class="w-3 h-3 rounded-full transition-all duration-300
                    @(index == _currentIndex
                                ? "bg-primary scale-125"
                                : "bg-gray-400 hover:bg-gray-500")">
                </button>
            }

        </div>
    }

</div>


@code
{
    [Parameter]
    public int ImageCount { get; set; } = 3;

    private int _currentIndex = 1;
    private bool _isPlaying;
    private bool _isHovered;
    private System.Timers.Timer? _timer;



    private string CurrentImage =>
    ImageCount > 0
        ? $"/assets/inspectionImage/{_currentIndex + 1}.png"
        : string.Empty;

    private void Next()
    {
        if (ImageCount <= 1)
            return;

        _currentIndex = (_currentIndex + 1) % ImageCount;
    }

    private void Previous()
    {
        if (ImageCount <= 1)
            return;

        _currentIndex =
            (_currentIndex - 1 + ImageCount) % ImageCount;
    }

    private void GoTo(int index)
    {
        if (index >= 0 && index < ImageCount)
            _currentIndex = index;
    }
}
