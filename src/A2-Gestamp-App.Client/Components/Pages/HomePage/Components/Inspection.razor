
<div class="flex h-full min-h-0 w-full flex-col overflow-hidden rounded-md bg-card">
	<div class="flex justify-between bg-border px-4 py-4 text-sm">
		<p>INSPEÇÃO ATUAL</p>
		<div class="flex gap-6">
			<p>

			</p>
			<div class="flex w-20 items-center justify-end gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera-icon lucide-camera text-primary"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z" /><circle cx="12" cy="13" r="3" /></svg>
				<span class="w-6">VS@(Camera?.CameraId)</span>
			</div>
		</div>
	</div>
	<div class="relative flex flex-1 overflow-hidden px-4 pt-4">
		<div class="relative flex h-full w-full items-center justify-center overflow-hidden rounded-md bg-black/50 shadow-lg">
			@if (Camera?.HasImage == true)
			{
				@if (RenderMode == InspectionRenderMode.Image)
				{
					<img src="@($"{Camera.ImagePath}?v={ImageVersion}")"
						 class="h-full w-full object-cover" />
				}
				else
				{
					<!-- Imagem de fundo -->
					<img src="@($"{Camera.ImagePath}?v={ImageVersion}")"
						 class="h-full w-full object-cover" />

					<!-- Overlay -->
					<img src="@($"{Camera.OverlayPath}?v={ImageVersion}")"
						 class="absolute inset-0 h-full w-full object-cover" />
				}
			}
			else
			{
				<p>Aguardando imagem...</p>
			}
		</div>

		@if (CameraCount > 1)
		{
			<button @onclick="Previous"
					class="absolute top-1/2 left-4 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-white transition hover:bg-black/70">

				❮

			</button>

			<button @onclick="Next"
					class="absolute top-1/2 right-4 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-white transition hover:bg-black/70">

				❯

			</button>
		}

	</div>

	@if (true)
	{
		<div class="flex justify-center gap-4 pt-2 pb-4">

			@for (int i = 0; i < 3; i++)
			{
				int index = i;

				<button @onclick="() => GoTo(index)"
						class="w-3 h-3 rounded-full transition-all duration-300
					@(index == CurrentIndex
							? "bg-primary scale-125"
							: "bg-gray-400 hover:bg-gray-500")">
				</button>
			}

		</div>
	}
</div>
