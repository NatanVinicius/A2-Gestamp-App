
<div class="h-full w-full min-h-0 flex flex-col bg-card rounded-md overflow-hidden">
  <div class="flex justify-between py-4 px-4 text-sm bg-border">
    <p>INSPEÇÃO ATUAL</p>
    <div class="flex gap-6">
      <p>
              
      </p>
      <div class="w-20 flex items-center justify-end gap-2">
        <i class="fa-solid fa-camera text-primary"></i>
        <span class="w-6">VS@(Camera?.CameraId)</span>
      </div>
    </div>
  </div>
    <div class="relative flex-1 flex overflow-hidden px-4 pt-4">
        <div class="w-full h-full flex items-center justify-center rounded-md shadow-lg overflow-hidden ">
            @if (Camera?.HasImage == true)
            {
                <img src="@Camera.ImagePath"
                     class="w-full h-full object-fill" />
            }
            else
            {
                <span>Aguardando imagem...</span>
            
            }
        </div>

        @if (CameraCount > 1)
        {
            <button @onclick="Previous"
                    class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition">

                ❮

            </button>

            <button @onclick="Next"
                    class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition">

                ❯

            </button>
        }

    </div>

    @if (true)
    {
        <div class="flex justify-center gap-4 pt-2 pb-4">

            @for (int i = 0; i < 3; i++)
            {
                int index = i;

                <button @onclick="() => GoTo(index)"
                        class="w-3 h-3 rounded-full transition-all duration-300
                    @(index == CurrentIndex
                            ? "bg-primary scale-125"
                            : "bg-gray-400 hover:bg-gray-500")">
                </button>
            }

        </div>
    }
</div>
