<div class="w-220 rounded-md overflow-hidden bg-card">
  <div class="text-sm py-4 px-4 text-sm bg-border">
    FERRAMENTAS
  </div>
        <div class="flex flex-col h-full w-full p-4 rounded-xl text-sm overflow-hidden">

            <!-- Cabeçalho -->
            <div class="grid grid-cols-3 text-sm font-semibold">
                <span>Nome</span>
                <span class="text-center">Tempo</span>
                <span class="text-end">Julgamento</span>
            </div>

            <!-- Conteúdo -->
            <div class="flex-1 overflow-y-auto text-white/80 scrollbar-none">
                
            @if (Camera is not null)
            {
                @foreach (var tool in Camera.Tools)
                {
    <div class="grid grid-cols-3 items-center py-2 border-b border-white/5 hover:bg-white/5">

        <span class="truncate">
            @tool.Name
        </span>

        <span class="text-center font-mono text-sm">
          @(tool.ExecutionTime.TotalMilliseconds.ToString("F1")) ms
        </span>

        <div class="flex justify-center ml-18">

            <span class="@(
                tool.Approved
                    ? "px-3 py-1 rounded-md bg-green-600 text-white text-xs font-semibold"
                    : "px-3 py-1 rounded-md bg-red-600 text-white text-xs font-semibold")">

                @(tool.Approved ? "GOOD" : "NG")

            </span>

        </div>

    </div>
}
                }

            </div>

        </div>
</div>
