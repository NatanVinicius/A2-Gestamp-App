@page "/"

@using A2GestampApp.Client.Components.Pages.HomePage.Components

<div class="flex h-full w-full flex-col gap-4 pr-2">

    <h3 class="text-white/60">
        > Home
    </h3>

    <Stats />

    <div class="flex min-h-0 flex-1 gap-4 overflow-hidden">

		<Inspection CameraCount="3"
					CurrentIndex="@_currentIndex"
					CurrentIndexChanged="@(i => _currentIndex = i)"
					Camera="@CurrentCamera"
					ImageVersion="@_imageVersion"
					RenderMode="InspectionRenderMode.Image" />

        <Tools Camera="@CurrentCamera" />

    </div>

</div>
