@using A2GestampApp.Client.Components.Shared.Settings

<header class="flex h-16 items-center bg-background p-2">

	<div>
		<img src="assets/logo.png" alt="Logo" class="h-10 w-auto" />
	</div>

	<button class="ml-8"
			@onclick="OpenCommunicationModal">
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-icon lucide-settings text-primary transition-colors ease-in-out hover:text-primary/90" "><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
	</button>

	<div class="flex flex-1 justify-center text-xs">
		<div class="flex gap-4">
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full @GetStatusColor(SystemState.GetCamera1Status())"></div>

				<p>Câmera 1</p>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full @GetStatusColor(SystemState.GetCamera2Status())"></div>

				<p>Câmera 2</p>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full @GetStatusColor(SystemState.GetCamera3Status())"></div>

				<p>Câmera 3</p>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full @GetStatusColor(SystemState.GetPlcStatus())"></div>
				<p>PLC</p>
			</div>
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full @GetStatusColor(SystemState.GetHikvisionStatus())"></div>
				<p>Face Id</p>
			</div>
		</div>

	</div>

	<div class="min-w-21">
		<p class="text-xl">@CurrentTime</p>
		<p class="text-center text-[14px] text-white/70">@CurrentDate</p>
	</div>

	<CommunicationSettingsModal @bind-IsOpen="IsCommunicationModalOpen" />

</header>
