@if (ConfirmationState.IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm">

        <div class="relative w-[500px] overflow-hidden rounded-xl bg-border shadow-2xl">

            <button
                class="absolute top-5 right-5 cursor-pointer text-white/50 hover:text-white"
                @onclick="ConfirmationState.Close">

				<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>

            </button>

            <div class="p-8">

                <div class="flex flex-col items-center text-center">

                    <h3 class="mt-4 text-2xl font-semibold text-white">
                        @ConfirmationState.Title
                    </h3>

                    <p class="mt-6 leading-7 text-white/70">
                        @ConfirmationState.Message
                    </p>

                    <button class="mt-8 cursor-pointer rounded-lg bg-green-500 px-8 py-3 font-semibold transition hover:bg-green-500/80"
                                @onclick="OnConfirm">

                            @ConfirmationState.ConfirmText

                        </button>

                </div>

            </div>

        </div>

    </div>
}
