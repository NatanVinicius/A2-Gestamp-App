@if (ConfirmationState.IsOpen)
{
    <div class="fixed inset-0 z-50 backdrop-blur-sm flex items-center justify-center">

        <div class="w-[500px] rounded-xl bg-border shadow-2xl overflow-hidden relative">

            <button
                class="absolute right-5 top-5 text-white/50 hover:text-white cursor-pointer"
                @onclick="ConfirmationState.Close">

                <i class="fa-solid fa-xmark text-xl"></i>

            </button>

            <div class="p-8">

                <div class="flex flex-col items-center text-center">

                    <h3 class="text-2xl font-semibold text-white mt-4">
                        @ConfirmationState.Title
                    </h3>

                    <p class="mt-6 text-white/70 leading-7">
                        @ConfirmationState.Message
                    </p>

                    <button class="mt-8 px-8 py-3 rounded-lg bg-green-500 hover:bg-green-500/80 transition font-semibold cursor-pointer"
                                @onclick="OnConfirm">

                            @ConfirmationState.ConfirmText

                        </button>

                </div>

            </div>

        </div>

    </div>
}
