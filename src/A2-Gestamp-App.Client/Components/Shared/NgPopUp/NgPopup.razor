@if (NgState.IsOpen)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm">
		<div class="w-[500px] overflow-hidden rounded-xl bg-border shadow-2xl">
			<div class="p-8">
				<div class="flex flex-col items-center text-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert-icon lucide-circle-alert text-primary"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></svg>
					<h3 class="mt-4 text-2xl font-semibold text-white">
						Inspeção Reprovada
					</h3>
					<p class="mt-4 max-w-lg leading-7 text-white/70">
						Autentifique-se no sistema para prosseguir.
					</p>
					<span class="max-w-lg text-sm leading-7 text-white/30">
						Clique no botão abaixo e direcione-se para o dispositivo de reconhecimento.
					</span>
					<button @onclick="OnStartRecognition"
							disabled="@(NgState.Status == FaceRecognitionStatus.Recognizing)"
							class="mt-8 cursor-pointer rounded-lg bg-primary px-8 py-3 font-semibold transition hover:bg-primary/80 disabled:cursor-not-allowed disabled:opacity-50">

						@(NgState.Status == FaceRecognitionStatus.Recognizing
							? "Reconhecendo..."
							: "Habilitar Face ID")

					</button>
					@if (NgState.Status == FaceRecognitionStatus.Recognizing)
					{
						<div class="mt-8">
							<p class="text-sm text-white/60">
								Tempo restante
							</p>
							<p class="mt-2 text-4xl font-bold text-primary">
								@NgState.RemainingSeconds s
							</p>
						</div>
					}
					<div class="mt-8 w-full rounded-lg px-5 py-4
						@(NgState.Status switch
						 {
							 FaceRecognitionStatus.Waiting => "bg-primary/10 border border-primary/30",
							 FaceRecognitionStatus.Recognizing => "bg-yellow-500/10 border border-yellow-500/30",
							 FaceRecognitionStatus.Success => "bg-green-500/10 border border-green-500/30",
							 FaceRecognitionStatus.Failed => "bg-red-500/10 border border-red-500/30",
							 _ => "bg-primary/10 border border-primary/30"
						 })">
						<div class="flex items-center justify-center gap-3">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
							<span class="text-sm text-white/80">
								@(NgState.Status switch
								{
									FaceRecognitionStatus.Waiting =>
										"Aguardando início da autenticação.",

									FaceRecognitionStatus.Recognizing =>
										"Reconhecimento facial em andamento...",

									FaceRecognitionStatus.Success =>
										"Operador reconhecido com sucesso. Redirecionando...",

									FaceRecognitionStatus.Failed =>
										"Operador não reconhecido. Tente novamente.",

									_ =>
										string.Empty
								})
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
