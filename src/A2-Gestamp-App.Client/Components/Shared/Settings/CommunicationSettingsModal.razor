@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm">

        <div class="w-[500px] rounded-xl border border-border bg-background shadow-xl">

            <!-- Header -->
            <div class="flex items-center border-b border-border px-6 py-4">

                <h2 class="text-md flex-1 text-center font-semibold">
                    Comunicações Externas
                </h2>

                <button @onclick="Close" 
        disabled="@IsLoading"
                        class="text-text-muted cursor-pointer text-white/70 transition hover:text-danger">
					<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                </button>

            </div>

            <!-- Body -->
            <div class="space-y-6 p-6">

                <div>
                    <label class="mb-2 block font-medium">
                        IP da Câmera
                    </label>

                    <p class="text-md text-text-muted mt-1 text-white/30 @GetStatusColor(Camera1Online)">
                        CAM1: @NetworkSettings.Value.Camera1
                    </p>

                    <p class="text-md text-text-muted mt-1 text-white/30 @GetStatusColor(Camera2Online)">
                        CAM2: @NetworkSettings.Value.Camera2
                    </p>

                    <p class="text-md text-text-muted mt-1 text-white/30 @GetStatusColor(Camera3Online)">
                        CAM3: @NetworkSettings.Value.Camera3
                    </p>
                </div>

                <div>
                    <label class="mb-2 block font-medium">
                        IP do PLC
                    </label>

                    <p class="text-md text-text-muted mt-1 text-white/30 @GetStatusColor(PlcOnline)">
                        @NetworkSettings.Value.Plc
                    </p>

                </div>

                <div>

                    <label class="mb-2 block font-medium">
                        IP do HOST
                    </label>

                    <p class="text-md text-text-muted mt-1 text-white/30 @GetStatusColor(HostOnline)">
                        @NetworkSettings.Value.Host
                    </p>

                </div>

            </div>

            <!-- Footer -->
            <div class="flex justify-end gap-3 border-t border-border px-6 py-4">

                <button @onclick="TestConnections"
                        disabled="@IsLoading"
                        class="flex w-40 cursor-pointer items-center justify-center rounded-lg bg-primary py-2 text-white transition disabled:cursor-not-allowed disabled:opacity-60">

                    <div class="flex h-4 w-4 items-center justify-center transition-all duration-150"
                         style="opacity:@(IsLoading ? "1" : "0"); margin-right:@(IsLoading ? "8px" : "-16px")">

                        <div class="h-4 w-4 animate-spin rounded-full border-2 border-dotted border-white border-t-transparent"></div>

                    </div>

                    <span>@(IsLoading ? "Testando..." : "Testar conexões")</span>

                </button>

            </div>

        </div>

    </div>
}
