@if (IsOpen)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm">

		<div class="relative w-[600px] overflow-hidden rounded-xl bg-border shadow-2xl">

			<button @onclick="Close"
					class="absolute top-4 right-4 cursor-pointer text-xl text-white/50 transition hover:text-white">
				<i class="fa-solid fa-xmark"></i>
			</button>

			<div class="p-8">

				<div class="flex flex-col">

					<div class="mt-6 flex items-center justify-center gap-4">

						<div>
							<h3 class="text-2xl font-semibold text-white">
								Configuração de modelos
							</h3>

							<p class="mt-1 text-center text-sm text-white/50">
								Selecione o modelo de cada mesa.
							</p>
						</div>

					</div>

					<div class="mt-8 space-y-6">

						<div>
							<label class="mb-2 block text-sm font-semibold text-white/80">
								Mesa 1
							</label>

							<select @bind="Table1ModelId"
									class="w-full rounded-lg border border-white/10 bg-background px-4 py-3 text-white transition outline-none focus:border-primary">
								<option value="" class="bg-background text-white">
									Nenhum modelo
								</option>

								@foreach (var recipe in Table1Recipes)
								{
									<option value="@recipe.Id" class="bg-background text-white">
										@recipe.Id - @recipe.Nome
									</option>
								}
							</select>
						</div>

						<div>
							<label class="mb-2 block text-sm font-semibold text-white/80">
								Mesa 2
							</label>

							<select @bind="Table2ModelId"
									class="w-full rounded-lg border border-white/10 bg-background px-4 py-3 text-white transition outline-none focus:border-primary">
								<option value="" class="bg-background text-white">
									Nenhum modelo
								</option>

								@foreach (var recipe in Table2Recipes)
								{
									<option value="@recipe.Id" class="bg-background text-white">
										@recipe.Id - @recipe.Nome
									</option>
								}
							</select>
						</div>

					</div>

					@if (!string.IsNullOrWhiteSpace(ErrorMessage))
					{
						<div class="mt-6 w-full rounded-lg border border-red-500/30 bg-red-500/10 px-5 py-4">

							<div class="flex items-center justify-center gap-3">

								<i class="fa-solid fa-circle-exclamation text-red-400"></i>

								<span class="text-sm text-white/80">
									@ErrorMessage
								</span>

							</div>

						</div>
					}

					<div class="mt-8 flex justify-end gap-3">

						<button @onclick="Close"
								class="cursor-pointer rounded-lg border border-white/10 px-6 py-3 font-semibold text-white/70 transition hover:bg-white/5 hover:text-white">
							Cancelar
						</button>

						<button @onclick="Confirm"
								disabled="@IsSaving"
								class="cursor-pointer rounded-lg bg-primary px-8 py-3 font-semibold text-white transition hover:bg-primary/80 disabled:cursor-not-allowed disabled:opacity-50">

							<i class="fa-solid fa-check mr-2"></i>

							@(IsSaving
								? "Aplicando..."
								: "Confirmar")

						</button>

					</div>

				</div>

			</div>

		</div>

	</div>
}
